  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My Dear Oliver, \n\nI'm so sorry to leave you, but I can't be the best
    version of myself here. It's been really hard on me the last few years. I think
    I can really make somthing of myself in the US. I promise i'll write to you and
    send you plenty of toys. Your Gran will give your Ma a hand if it gets tough.\nYou're
    a good boy Ol, and try be kind to your Ma... she's not the easiest to get along
    with but you'll be alright !\n\nLove,\nDad\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 685b6d1928f960943b2b3900d683b82e, type: 2}
